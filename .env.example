# Copier ce fichier en .env puis renseigner vos propres valeurs.
# Le fichier .env est ignoré par Git : ne jamais le versionner.

# PostgreSQL (base source alimentée par le simulateur)
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=postgres
PG_USER=postgres
PG_PASSWORD=change_me

# MySQL (data warehouse alimenté par l'ETL)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=industrial_iot_dw
MYSQL_USER=root
MYSQL_PASSWORD=change_me
